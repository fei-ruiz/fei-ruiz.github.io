{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/cursor/**",
              "components/feedback/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Space Grotesk|Manrope|Inter Tight))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Space Grotesk, Manrope, Inter Tight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|shape|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, shape."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|violet|accent|outline)$/]",
        "message": "<Badge> tone must be one of 'ink' | 'violet' | 'accent' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|rect|circle)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'rect' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|shape|size|uppercase|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, shape, size, uppercase, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|invert|invert-light|outline|ghost|electric)$/]",
        "message": "<Button> variant must be one of 'solid' | 'invert' | 'invert-light' | 'outline' | 'ghost' | 'electric'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:rect|pill)$/]",
        "message": "<Button> shape must be one of 'rect' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CursorLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|word|dark|key|ref|className|style|children)$/]",
        "message": "<CursorLabel> doesn't accept that prop. Declared props: children, word, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|ctaLabel|imageSlot|tone|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: eyebrow, title, description, ctaLabel, imageSlot, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|sage|ink)$/]",
        "message": "<FeatureCard> tone must be one of 'paper' | 'sage' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeIndex|onSelect|key|ref|className|style|children)$/]",
        "message": "<ImageRail> doesn't accept that prop. Declared props: items, activeIndex, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|links|dark|ctaLabel|onMenuClick|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: mark, links, dark, ctaLabel, onMenuClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|dark|avatar|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: quote, name, role, dark, avatar."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevealImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:imageSlot|label|aspect|key|ref|className|style|children)$/]",
        "message": "<RevealImage> doesn't accept that prop. Declared props: imageSlot, label, aspect."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|label|dark|key|ref|className|style|children)$/]",
        "message": "<SectionMarker> doesn't accept that prop. Declared props: index, total, label, dark."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
